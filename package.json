{
  "name": "agent-vault",
  "version": "1.2.0",
  "description": "Unified conversation history aggregator, search engine, and cross-machine vault for AI coding agents (pi, opencode, agy, freebuff, hermes)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-vault": "bin/agent-vault.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node bin/agent-vault.js",
    "setup": "./scripts/init.sh",
    "reindex": "node bin/agent-vault.js reindex",
    "clean": "rm -rf dist .cache"
  },
  "keywords": [
    "ai-agent",
    "conversation-history",
    "cli",
    "pi",
    "opencode",
    "agy",
    "freebuff",
    "hermes",
    "sqlite",
    "fts5"
  ],
  "author": "zzlee",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.8.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
